rules_version = '2';

// Firestore security rules for Hack the Coast applications.
//
// These rules only apply to the client SDK (the browser). Server code that
// uses the Firebase Admin SDK (e.g. API routes in src/app/api) bypasses them,
// which is how the server moves an application out of "draft" (to
// "submitted", "accepted", "waitlisted", "rejected", "confirmed" or
// "declined"). See src/lib/applicationSchema.ts for what each status means.
//
// Deploy with: npx firebase-tools deploy --only firestore:rules --project <project-id>

service cloud.firestore {
  match /databases/{database}/documents {

    // One application per applicant, stored at applications/{their uid}.
    match /applications/{userId} {

      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // Fields an applicant is allowed to write: exactly the fields of the
      // ApplicationDraft type in src/app/application/page.tsx, which is
      // derived from the Application type in src/lib/applicationSchema.ts
      // (minus the server-only fields email and submittedAt, and resumeUrl
      // until resume upload is built). Listed in schema order. When a field
      // is added to or removed from the draft type, update this list too.
      function hasOnlyDraftFields() {
        return request.resource.data.keys().hasOnly([
          'status',

          // Personal info
          'firstName',
          'lastName',
          'ageRange',
          'pronouns',
          'country',
          'phone',

          // Profile
          'school',
          'levelOfStudy',
          'major',
          'yearLevel',

          // Additional info
          'hackathonsAttended',
          'dietaryRestrictions',
          'referralSource',

          // Short answers
          'hopeToLearn',
          'recentChallenge',
          'teamRole',
          'favouriteBodyOfWater',
          'playlistSong',

          // Consent
          'consentUbcCoc',
          'consentMlhCoc',
          'consentMlhDataSharing',
          'consentSusEmails',
          'consentPhotos',
          'consentMlhMarketing'
        ]);
      }

      // Applicants can always read their own application (so they can see
      // their status), but never anyone else's.
      allow read: if isOwner();

      // Creating a new application: it must start as a draft.
      allow create: if isOwner()
        && hasOnlyDraftFields()
        && request.resource.data.status == 'draft';

      // Editing: only while it's still a draft, and the status can't change.
      // Once the server moves it past "draft", the applicant
      // can no longer edit it.
      allow update: if isOwner()
        && hasOnlyDraftFields()
        && resource.data.status == 'draft'
        && request.resource.data.status == 'draft';

      // Applicants can't delete their application.
      allow delete: if false;
    }

    // Everything else is closed to the client by default.
  }
}
